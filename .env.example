# App URL (your production domain on Vercel e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Vision model: GEMINI_API_KEY (free tier) or OPENAI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Supabase database & authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (Sandbox or Live)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=

# Server-only safety reviewers (Supabase user UUIDs, comma-separated)
ADMIN_USER_IDS=
# Must match the secret stored by upgrade-pickups.mjs in Supabase Vault
CRON_SECRET=

# Gmail SMTP for Supabase Auth emails (Run `pnpm setup:smtp` to apply to Supabase)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SUPABASE_ACCESS_TOKEN=
